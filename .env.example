# ---------------------------------------------------------------------------
# SRCS frontend environment
# ---------------------------------------------------------------------------

# Where the app sends API requests. Leave unset to use the relative "/api"
# path, which the Vite dev server proxies to the backend (see below). Set this
# to an absolute URL to talk to a deployed backend directly (the backend has
# CORS enabled).
VITE_API_BASE_URL=http://localhost:3000/api

# The backend origin the Vite dev server proxies "/api" to during `npm run dev`.
VITE_API_PROXY_TARGET=http://localhost:3000

# Set to "true" to run against the in-browser mock backend instead of a real
# server (no backend required). Leave unset/false for real API integration.
# VITE_USE_MOCKS=false
